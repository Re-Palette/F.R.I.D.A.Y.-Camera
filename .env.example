# ─── F.R.I.D.A.Y. service wiring ────────────────────────────────────────────
# Global default for every service: "mock" or "real".
VITE_FRIDAY_MODE=mock

# Per-service overrides (optional). Values: mock | real
#   vision additionally accepts "ondevice" (MediaPipe object detector in-browser)
# VITE_SERVICE_VISION=ondevice
# VITE_SERVICE_LLM=real
# VITE_SERVICE_SEARCH=real
# VITE_SERVICE_WEATHER=real      # Open-Meteo, no key required
# VITE_SERVICE_NEWS=real
# VITE_SERVICE_PLACES=real
# VITE_SERVICE_TRANSLATE=real
# VITE_SERVICE_VOICE=real        # Web Speech API (browser)
# VITE_SERVICE_LOCATION=real     # Geolocation + DeviceOrientation (browser)
# VITE_SERVICE_MEMORY=real       # IndexedDB (browser) + optional remote semantic index

# Backend gateway that holds API keys (LLM / search / vision / news / places).
# Never put provider API keys in VITE_* variables — they ship to the browser.
VITE_FRIDAY_API_BASE=http://localhost:8787/api
